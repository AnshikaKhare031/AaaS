# ==========================================================
# AaaS Handmade Crochet - Frontend Environment Variables
# ==========================================================

# Supabase Public API Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# FastAPI Backend URL (Defaults to /api via Vite dev proxy)
VITE_API_BASE_URL=http://localhost:8000/api

# Razorpay Public Key ID (for Razorpay Standard Checkout modal)
# Safe to expose in frontend; NEVER put secret key in frontend!
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
