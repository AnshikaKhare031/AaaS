{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/server/**/*",
    "api/**/*",
    "server.ts",
    "tests/**/*",
    "middleware.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend",
    "backend"
  ]
}
