# ==========================================================
# AaaS Handmade Crochet - Backend Environment Variables
# ==========================================================

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# PostgreSQL Direct Connection String (Optional, for direct asyncpg / migrations)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres


# Server & CORS Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Admin Security Key / Secret for emergency overrides
ADMIN_SECRET_KEY=aaas-crochet-super-secret-admin-key-change-in-prod
