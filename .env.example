# ==============================================================================
# AaaS Atelier - Environment Configuration Template
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication & Admin Secrets
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SESSION_SECRET=your-64-character-hex-admin-session-secret
CUSTOMER_SESSION_SECRET=your-64-character-hex-customer-session-secret

# Razorpay Payment Gateway Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_public_key
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=AaaS Atelier <orders@aaasatelier.in>
RESEND_REPLY_TO=hello@aaasatelier.in
ADMIN_NOTIFICATION_EMAIL=admin@aaasatelier.in

# Site & Cron Configuration
NEXT_PUBLIC_SITE_URL=https://www.aaasatelier.in
CRON_SECRET=your-secure-cron-secret-token

# Social & Contact
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_INSTAGRAM_USERNAME=aaas.atelier
